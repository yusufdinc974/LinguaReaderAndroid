{
  "name": "linguareader-android",
  "private": true,
  "version": "2.0.0",
  "description": "LinguaReader for Android, built on the desktop app's code",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "node --test test/*.test.ts && vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@noble/hashes": "^2.4.0",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^8.1.1",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sql.js": "^1.17.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/node": "^22.20.7",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.7.0",
    "onnxruntime-node": "^1.31.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
